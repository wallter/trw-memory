+    def _openai_extra_body(self) -> dict[str, Any]:
+        """TRW patch: LLM_EXTRA_BODY env (JSON) is merged into every chat call.
+
+        Used to pass Ollama-only knobs such as {"reasoning_effort": "none"} so
+        thinking models answer directly. Empty when the env var is unset.
+        """
+        raw = os.getenv("LLM_EXTRA_BODY", "").strip()
+        if not raw:
+            return {}
+        return {"extra_body": json.loads(raw)}
