# pip-compile lockfile (dev-machine specific, too broad for public repo —
# leaks non-dependency monorepo packages like Authlib/fastapi into the public subtree)
requirements.lock

# IDE
.vscode/
.idea/

# TRW runtime state
.trw/

# Internal Claude Code settings — not for public consumption
.claude/

# Internal PRD/sprint docs — development artefacts, not part of the public package
docs/

# Scratch workspace
scratch/

# Local memory store + test artifacts (must never ship to PyPI)
.memory/
coverage.json
.trw/distill/anon_salt

# PRD-CORE-253 FR01 derives security state as the `security` SIBLING of the
# resolved store directory (it used to be a nested `.trw/security`, which was
# wrong under an XDG base). With the default relative storage_path (".memory"),
# a test run in this package root drops audit/anomaly state here. Runtime state,
# never source.
/security/
